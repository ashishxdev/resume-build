# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth storage (use memory locally; switch to mongodb for persistent environments)
AUTH_STORAGE=memory
MONGODB_URI=
MONGODB_DATABASE=make_my_resume

# Better Auth (hosted by the API)
BETTER_AUTH_SECRET=<generate-a-strong-secret>
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_API_KEY=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Comma-separated proxy IPs/CIDRs trusted to supply the original client IP.
TRUSTED_PROXY_IPS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 resume originals (R2_ENDPOINT is optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Provider-neutral AI resume parsing (currently supports Gemini)
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM="Make My Resume <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# Provider-neutral payments (provider not selected/wired yet)
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
