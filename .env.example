# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DATABASE=make_my_resume

# Better Auth (hosted by the API)
BETTER_AUTH_SECRET=<generate-a-strong-secret>
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (not wired in the initial scaffold)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Provider-neutral AI configuration (provider not wired yet)
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# Resend (not wired yet)
RESEND_API_KEY=
EMAIL_FROM=

# Provider-neutral payments (provider not selected/wired yet)
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
